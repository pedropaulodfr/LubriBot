# ============================================================
# LubriBot — modelo de variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o .env preenchido.
# ============================================================

# ------------------------------------------------------------ ambiente
# "PRODUÇÃO"/"PRODUCAO" ativa produção; qualquer outro valor usa QA.
# Acentos são normalizados, então "Produção" e "PRODUCAO" funcionam.
AMBIENTE=QA

# ------------------------------------------------------------ Telegram
# Token de produção (BotFather). Obrigatório quando AMBIENTE=PRODUÇÃO.
TOKEN=
# Token de QA/desenvolvimento. Obrigatório quando AMBIENTE=QA.
TOKEN_QA=

# ------------------------------------------------------------ banco PostgreSQL
# Ex.: postgresql://usuario:senha@host:porta/banco
# Em Supabase, prefira o pooler (porta 6543) em produção.
STRING_CONNECTION=
STRING_CONNECTION_LOCAL=

# ------------------------------------------------------------ IA (Google Gemini)
GEMINI_ApiKey=

# ------------------------------------------------------------ armazenamento de imagens (AWS S3)
AWS_AccessKey=
AWS_SecretKey=
AWS_Region=
AWS_BucketName=

# ------------------------------------------------------------ notificações
# Minutos entre ciclos do job de notificações (padrão 60).
INTERVALO_NOTIFICACAO=60
# Intervalo padrão de manutenção em dias, usado quando o serviço não tem
# `intervaloDias` preenchido (padrão 180).
INTERVALO_MANUTENCAO_DIAS=180
# Intervalo padrão em km, usado quando o serviço não tem `intervaloKm`.
# Deixe vazio para desabilitar a notificação por quilometragem.
INTERVALO_KM_PADRAO=

# ------------------------------------------------------------ servidor HTTP / operação
# Porta do health check (`GET /ping`). Em VPS pode ficar em 10000 ou outra.
PORT=10000
LOG_LEVEL=INFO
# Habilita comandos de debug (/teste). Manter false em produção.
DEBUG_COMMANDS=false

# ------------------------------------------------------------ limites de IA (por usuário/dia)
IA_DIAGNOSTICOS_DIA=3
IA_DICAS_DIA=10
